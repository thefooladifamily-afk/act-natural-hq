{
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@react-three/xr": "^6.6.31",
    "ratk": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
