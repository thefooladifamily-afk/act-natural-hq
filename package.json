    "test:loop": "node --import ./tests/register.mjs tests/loop-test.mjs",
    "test:recut": "node --import ./tests/register.mjs tests/recut-test.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "checkpoint": "node scripts/checkpoint.mjs",
    "evidence": "node scripts/evidence-capture.mjs",
    "demo": "node scripts/demo-path.mjs",
